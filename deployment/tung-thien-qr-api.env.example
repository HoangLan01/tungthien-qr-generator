NODE_ENV=production
PORT=3000

RAPIDAPI_KEY=
QRCODE_MONKEY_API_BASE=
QRCODE_MONKEY_API_HOST=
QR_DEFAULT_SIZE=1000
QR_REQUEST_TIMEOUT_MS=10000

RATE_LIMIT_WINDOW_MS=60000
